# Copier ce fichier en .env (cp .env.example .env) puis adapter les valeurs.
# .env est ignoré par Git. Le mot de passe de la base n'est PAS ici :
# il est fourni par Docker Secrets (voir secrets/db_password.txt).

# Utilisateur et base PostgreSQL
POSTGRES_USER=demo
POSTGRES_DB=demo

# Ports publiés sur l'hôte
API_PORT=8080
ADMINER_PORT=8081
